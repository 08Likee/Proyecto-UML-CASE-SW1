# Solo plantilla: no guardes credenciales reales en Git.
# Reemplaza TU_IP_ESTATICA por la IPv4 estatica publica de Lightsail.
PUBLIC_URL=https://TU_IP_ESTATICA

POSTGRES_DB=herramienta_case
POSTGRES_USER=case_user
POSTGRES_PASSWORD=CAMBIAR_POR_CLAVE_ALEATORIA

JWT_ACCESS_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO
JWT_REFRESH_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DIFERENTE
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

JWT_PASSWORD_RECOVERY_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO
JWT_PASSWORD_RECOVERY_TTL_SECONDS=900
COLLABORATION_SERVICE_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DIFERENTE

# NO copies aqui la clave real; introducirla solo en deploy/.env.production del servidor.
GROQ_API_KEY=CAMBIAR_POR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=20000

VITE_API_URL=/api
VITE_COLLABORATION_URL=wss://TU_IP_ESTATICA/collaboration

# La opcion console puede imprimir enlaces de recuperacion en logs.
PASSWORD_RECOVERY_NOTIFIER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
