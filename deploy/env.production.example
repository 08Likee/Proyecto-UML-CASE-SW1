# URL pública actual del despliegue.
# Primera prueba por IP:
# PUBLIC_URL=http://203.0.113.10
# Después, con dominio y HTTPS:
# PUBLIC_URL=https://case.example.com
PUBLIC_URL=http://REEMPLAZAR_IP_ESTATICA

POSTGRES_DB=herramienta_case
POSTGRES_USER=case_user
POSTGRES_PASSWORD=REEMPLAZAR_POR_SECRETO_SEGURO

JWT_ACCESS_SECRET=REEMPLAZAR_POR_SECRETO_SEGURO
JWT_REFRESH_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_SEGURO
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

JWT_PASSWORD_RECOVERY_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_SEGURO
JWT_PASSWORD_RECOVERY_TTL_SECONDS=900

COLLABORATION_SERVICE_SECRET=REEMPLAZAR_POR_SECRETO_SEGURO

# El frontend puede usar /api porque Nginx y React comparten origen.
VITE_API_URL=/api

# Durante la primera prueba HTTP:
# VITE_COLLABORATION_URL=ws://203.0.113.10/collaboration
# Cuando se habilite HTTPS:
# VITE_COLLABORATION_URL=wss://case.example.com/collaboration
VITE_COLLABORATION_URL=ws://REEMPLAZAR_IP_ESTATICA/collaboration

# Para esta versión académica puede mantenerse la recuperación por consola.
PASSWORD_RECOVERY_NOTIFIER=console

# Solo son necesarios si más adelante se activa un notificador SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
